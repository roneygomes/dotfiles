# Brewfile — work profile (all hosts other than bluestar)
# Shared tooling + work-only packages. For the personal machine, see Brewfile.personal.

tap "hashicorp/tap"
tap "hex-inc/hex-cli"
tap "d12frosted/emacs-plus", trusted: true

brew "stow"
brew "fzf"
brew "gh"
brew "docker-compose"
brew "docker-buildx"
brew "libpq"
brew "jwt-cli"
brew "hashicorp/tap/terraform", trusted: true
brew "hex-inc/hex-cli/hex", trusted: true
brew "ffmpeg"
brew "poppler"
brew "pipx"
brew "uv"
brew "cmake"
brew "libtool"
brew "openssl@3"
brew "ripgrep"
brew "bat"
brew "tmux"
brew "openjdk"
brew "python@3.12"

cask "bitwarden", trusted: true
cask "slack", trusted: true
cask "emacs-plus-app", trusted: true

cask "gcloud-cli"
cask "claude-code@latest"

cask "orbstack"
cask "iterm2"

cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
cask "font-iosevka"
