{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude-profiles/work/mods/lowercase-titles"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/roney/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "credix-claude-skills@credix-plugins": true,
    "code-review@claude-plugins-official": true,
    "aikido@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "laconic@claude-laconic": true,
    "postman@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "claude-laconic": {
      "source": {
        "source": "github",
        "repo": "spenhouet/claude-laconic"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Git operations in /Users/roney/projects/dotfiles (including `git stash pop`/`apply`, `git checkout stash@{N} -- <file>`, `git commit`, and `git push origin main`) are pre-authorized — this is a personal single-author dotfiles repo with no PR workflow, and pushing directly to main is the intended sync mechanism (also invoked by the scheduled `dotfiles-sync` task)."
    ]
  },
  "voiceEnabled": true,
  "trustedDirectories": [
    "/Users/roney/.config/gcloud"
  ],
  "outputStyle": "Concise"
}